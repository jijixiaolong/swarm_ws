#!/usr/bin/env python3
"""
Export rosbag2 experiment data to CSV and write a topic summary.

Typical usage:
  ros2 run fsmpx4 analyze_swarm_bag ~/swarm_bags/swarm_20260312_153000
"""

import argparse
import csv
import re
import sys
from collections import defaultdict
from collections.abc import Mapping, Sequence
from pathlib import Path
from typing import Any

import rosbag2_py
from rclpy.serialization import deserialize_message
from rosidl_runtime_py.convert import message_to_ordereddict
from rosidl_runtime_py.utilities import get_message


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Export swarm rosbag data to CSV")
    parser.add_argument("bag_path", help="Path to the rosbag2 directory")
    parser.add_argument(
        "--output-dir",
        default=None,
        help="Directory for exported CSV and summary (default: <bag_path>/analysis)",
    )
    parser.add_argument(
        "--storage-id",
        default="sqlite3",
        help="rosbag2 storage backend used by the bag (default: %(default)s)",
    )
    parser.add_argument(
        "--skip-plots",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--planner-self-index",
        type=int,
        default=None,
        help=argparse.SUPPRESS,
    )
    return parser.parse_args()


def is_sequence(value: Any) -> bool:
    return isinstance(value, Sequence) and not isinstance(value, (str, bytes, bytearray))


def flatten_value(value: Any, prefix: str, out: dict[str, Any]) -> None:
    if isinstance(value, Mapping):
        for key, item in value.items():
            next_prefix = f"{prefix}.{key}" if prefix else str(key)
            flatten_value(item, next_prefix, out)
        return
    if is_sequence(value):
        if not value:
            out[prefix] = ""
            return
        for idx, item in enumerate(value):
            next_prefix = f"{prefix}[{idx}]"
            flatten_value(item, next_prefix, out)
        return
    out[prefix] = value


def sanitize_name(name: str) -> str:
    cleaned = name.strip().strip("/")
    if not cleaned:
        return "root"
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", cleaned)


def ordered_fieldnames(row: Mapping[str, Any]) -> list[str]:
    preferred = ["_bag_time_ns", "_bag_time_s"]
    others = sorted(key for key in row.keys() if key not in preferred)
    return preferred + others


def _discover_topic_fieldnames(
    bag_path: Path,
    storage_id: str,
    topic_classes: Mapping[str, Any],
    topic_types: Mapping[str, str],
    t_start: float | None,
    t_end: float | None,
) -> tuple[dict[str, list[str]], dict[str, str]]:
    """Second pass before export: gather the full key set for each topic.

    Some topics, especially MarkerArray, do not keep a fixed flattened schema
    across messages. DictWriter requires a stable header, so we must union all
    observed keys in the selected export window first.
    """

    reader = rosbag2_py.SequentialReader()
    reader.open(
        rosbag2_py.StorageOptions(uri=str(bag_path), storage_id=storage_id),
        rosbag2_py.ConverterOptions(
            input_serialization_format="cdr",
            output_serialization_format="cdr",
        ),
    )

    field_sets: dict[str, set[str]] = defaultdict(set)
    skipped_topics: dict[str, str] = {}
    discovery_deserialize_failures: dict[str, int] = defaultdict(int)

    while reader.has_next():
        topic, serialized, bag_time_ns = reader.read_next()

        bag_time_s = float(bag_time_ns) * 1e-9
        if t_start is not None and t_end is not None:
            if bag_time_s < t_start or bag_time_s > t_end:
                continue

        try:
            msg = deserialize_message(serialized, topic_classes[topic])
        except Exception as exc:  # pragma: no cover - depends on bag contents
            discovery_deserialize_failures[topic] += 1
            print(
                f"Warning: deserialize failed for {topic} during field discovery "
                f"(count={discovery_deserialize_failures[topic]}): {exc}",
                file=sys.stderr,
            )
            continue

        row: dict[str, Any] = {}
        flatten_value(message_to_ordereddict(msg), "", row)
        row["_bag_time_ns"] = int(bag_time_ns)
        row["_bag_time_s"] = bag_time_s
        field_sets[topic].update(row.keys())

    fieldnames = {
        topic: ordered_fieldnames({key: None for key in keys})
        for topic, keys in field_sets.items()
    }
    return fieldnames, skipped_topics


def clear_generated_outputs(csv_dir: Path, summary_path: Path) -> None:
    for path in csv_dir.glob("*.csv"):
        path.unlink()
    if summary_path.exists():
        summary_path.unlink()


def _compute_cmd_time_range(bag_path: Path, storage_id: str) -> tuple[float | None, float | None]:
    """First pass: find [t_start, t_end] when offboard_control_mode is published (cmd mode)."""
    cmd_times: list[float] = []
    pattern = re.compile(r"/px4_\d+/fmu/in/offboard_control_mode")
    reader = rosbag2_py.SequentialReader()
    reader.open(
        rosbag2_py.StorageOptions(uri=str(bag_path), storage_id=storage_id),
        rosbag2_py.ConverterOptions(
            input_serialization_format="cdr",
            output_serialization_format="cdr",
        ),
    )
    while reader.has_next():
        topic, _serialized, bag_time_ns = reader.read_next()
        if pattern.search(topic):
            cmd_times.append(float(bag_time_ns) * 1e-9)
    if not cmd_times:
        return None, None
    return min(cmd_times), max(cmd_times)


def write_summary(
    summary_path: Path,
    bag_path: Path,
    topic_counts: Mapping[str, int],
    topic_types: Mapping[str, str],
    csv_paths: Mapping[str, Path],
    skipped_topics: Mapping[str, str],
) -> None:
    with summary_path.open("w", encoding="utf-8") as handle:
        handle.write(f"bag_path: {bag_path}\n")
        handle.write("topics:\n")
        for topic in sorted(topic_counts):
            handle.write(
                f"  {topic}: type={topic_types[topic]} messages={topic_counts[topic]} "
                f"csv={csv_paths[topic]}\n"
            )
        if skipped_topics:
            handle.write("skipped_topics:\n")
            for topic in sorted(skipped_topics):
                handle.write(f"  {topic}: {skipped_topics[topic]}\n")


def main() -> int:
    args = parse_args()
    bag_path = Path(args.bag_path).expanduser().resolve()
    if not bag_path.exists():
        print(f"Bag path does not exist: {bag_path}", file=sys.stderr)
        return 2

    output_dir = (
        Path(args.output_dir).expanduser().resolve()
        if args.output_dir
        else bag_path / "analysis"
    )
    csv_dir = output_dir / "csv"
    summary_path = output_dir / "summary.txt"
    csv_dir.mkdir(parents=True, exist_ok=True)
    clear_generated_outputs(csv_dir, summary_path)

    t_start, t_end = _compute_cmd_time_range(bag_path, args.storage_id)
    if t_start is None or t_end is None:
        print("Warning: no offboard_control_mode messages found, exporting full bag", file=sys.stderr)
    else:
        print(f"Exporting only cmd-mode window [{t_start:.2f}, {t_end:.2f}] s (from offboard_control_mode)")

    reader = rosbag2_py.SequentialReader()
    reader.open(
        rosbag2_py.StorageOptions(uri=str(bag_path), storage_id=args.storage_id),
        rosbag2_py.ConverterOptions(
            input_serialization_format="cdr",
            output_serialization_format="cdr",
        ),
    )

    topic_info = reader.get_all_topics_and_types()
    topic_types = {topic.name: topic.type for topic in topic_info}
    topic_classes = {name: get_message(topic_type) for name, topic_type in topic_types.items()}
    topic_fieldnames, skipped_topics = _discover_topic_fieldnames(
        bag_path, args.storage_id, topic_classes, topic_types, t_start, t_end
    )
    topic_counts: dict[str, int] = defaultdict(int)
    csv_paths: dict[str, Path] = {}
    csv_files: dict[str, Any] = {}
    csv_writers: dict[str, csv.DictWriter] = {}

    export_deserialize_failures: dict[str, int] = defaultdict(int)
    try:
        while reader.has_next():
            topic, serialized, bag_time_ns = reader.read_next()
            if topic in skipped_topics:
                continue

            try:
                msg = deserialize_message(serialized, topic_classes[topic])
            except Exception as exc:  # pragma: no cover - depends on bag contents
                export_deserialize_failures[topic] += 1
                print(
                    f"Warning: deserialize failed for {topic} during export "
                    f"(count={export_deserialize_failures[topic]}): {exc}",
                    file=sys.stderr,
                )
                continue

            row = {}
            flatten_value(message_to_ordereddict(msg), "", row)
            row["_bag_time_ns"] = int(bag_time_ns)
            row["_bag_time_s"] = float(bag_time_ns) * 1e-9

            bag_time_s = row["_bag_time_s"]
            if t_start is not None and t_end is not None:
                if bag_time_s < t_start or bag_time_s > t_end:
                    continue

            if topic not in topic_fieldnames:
                topic_fieldnames[topic] = ordered_fieldnames(row)

            if topic not in csv_writers:
                csv_path = csv_dir / f"{sanitize_name(topic)}.csv"
                csv_paths[topic] = csv_path
                csv_file = csv_path.open("w", newline="", encoding="utf-8")
                writer = csv.DictWriter(
                    csv_file,
                    fieldnames=topic_fieldnames[topic],
                    extrasaction="ignore",
                )
                writer.writeheader()
                csv_files[topic] = csv_file
                csv_writers[topic] = writer
            csv_writers[topic].writerow(row)
            topic_counts[topic] += 1
    finally:
        for csv_file in csv_files.values():
            csv_file.close()

    write_summary(summary_path, bag_path, topic_counts, topic_types, csv_paths, skipped_topics)

    print(f"Bag analysis written to: {output_dir}")
    print(f"Summary: {summary_path}")
    print(f"CSV files: {csv_dir}")
    if skipped_topics:
        print(
            "Skipped topics due to deserialization failures:",
            ", ".join(sorted(skipped_topics)),
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
